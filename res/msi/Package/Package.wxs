<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
	xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
	xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

	<?include Includes.wxi?>

	<Package Name="$(var.DisplayName)" Version="$(var.Version)" Manufacturer="$(var.Manufacturer)" Language="!(loc.ProductLanguage)" UpgradeCode="$(var.UpgradeCode)" Scope="perMachine">

		<SummaryInformation Keywords="Installer" Description="$(var.Description)" Codepage="!(loc.SummaryCodepage)" />

		<!--<PropertyRef Id="UpgradesFile" />-->

		<PropertyRef Id="AddRemovePropertiesFile" />

		<Media Id="1" Cabinet="cab1.cab" EmbedCab="yes" CompressionLevel="high" />
		<Icon Id="AppIcon" SourceFile="Resources\icon.ico" />

		<!-- User Interface -->
		<WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

		<ui:WixUI Id="UI_MyInstallDialog" InstallDirectory="INSTALLFOLDER_INNER" />
		<UIRef Id="WixUI_ErrorProgressText" />

		<?ifndef YesDesk?>
		<InstallUISequence>
			<Show Dialog="UI_AnotherAppDialog" Before="WelcomeDlg" Condition="Not installed AND APP_WINDOWS_INSTALLER=&quot;#0&quot;"/>
		</InstallUISequence>

		<InstallExecuteSequence>
			<InstallExecute After="RemoveExistingProducts" />

			<!--Only do InstallValidate if is not Uninstall-->
			<!--<InstallValidate Condition="NOT (Installed AND REMOVE AND NOT UPGRADINGPRODUCTCODE )" />-->
			<!--Only do InstallValidate if is Install-->
			<InstallValidate Condition="NOT Installed" />

		</InstallExecuteSequence>
		<?endif?>

		<?ifdef YesDesk?>
		<Property Id="YESDESK_LAUNCH_APP" Value="1" Secure="yes" />
		<Property Id="YESDESK_DEFER_SERVICE_START" Secure="yes" />
		<Property Id="YESDESK_SKIP_SERVICE" Secure="yes" />
		<Property Id="YESDESK_INSTALLED_EXE">
			<RegistrySearch Id="YesDeskExecutable" Root="HKLM" Bitness="always64"
				Key="Software\YES Apart\YES Desk\Installer" Name="ExecutableName" Type="raw" />
		</Property>
		<Property Id="YESDESK_LEGACY_NATIVE">
			<RegistrySearch Id="YesDeskLegacyNative" Root="HKLM" Bitness="always64"
				Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\YES Desk" Name="InstallLocation" Type="raw" />
		</Property>
		<Property Id="YESDESK_LEGACY_NATIVE_X86">
			<RegistrySearch Id="YesDeskLegacyNativeX86" Root="HKLM" Bitness="always32"
				Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\YES Desk" Name="InstallLocation" Type="raw" />
		</Property>
		<Property Id="YESDESK_LEGACY_MSI_NAME">
			<RegistrySearch Id="YesDeskLegacyMsiName" Root="HKLM" Bitness="always64"
				Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\RustDesk" Name="DisplayName" Type="raw" />
		</Property>
		<Property Id="YESDESK_LEGACY_MSI_PUBLISHER">
			<RegistrySearch Id="YesDeskLegacyMsiPublisher" Root="HKLM" Bitness="always64"
				Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\RustDesk" Name="Publisher" Type="raw" />
		</Property>
		<Property Id="YESDESK_EXISTING_SERVICE">
			<RegistrySearch Id="YesDeskServiceImage" Root="HKLM" Bitness="always64"
				Key="SYSTEM\CurrentControlSet\Services\YES Desk" Name="ImagePath" Type="raw" />
		</Property>
		<Upgrade Id="D3DC41E3-3C37-5D52-BB47-F6673705C01B">
			<UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes" OnlyDetect="yes" Property="YESDESK_LEGACY_FAMILY" />
		</Upgrade>
		<Launch Condition='Installed OR (NOT YESDESK_LEGACY_NATIVE_X86 AND NOT YESDESK_LEGACY_NATIVE AND (YESDESK_INSTALLED_EXE ~= "YES_Desk.exe" OR NOT YESDESK_EXISTING_SERVICE) AND NOT YESDESK_LEGACY_MSI_NAME ~&gt;&lt; "YES Desk" AND NOT YESDESK_LEGACY_MSI_PUBLISHER ~= "YES Apart" AND (NOT YESDESK_LEGACY_FAMILY OR YESDESK_LEGACY_MSI_NAME ~= "RustDesk"))'
			Message="An earlier or unidentified remote-support installation was found. Back up its settings and verify which product it belongs to before migrating to YES Desk. See YESDESK-WINDOWS-INSTALLATION.md." />
		<SetDirectory Id="INSTALLFOLDER_INNER" Action="SetYesDeskInstallDirectory" Value="[ProgramFiles64Folder]YES Desk\" />
		<SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER_INNER]" After="SetYesDeskInstallDirectory" Sequence="execute" />
		<?endif?>

		<MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeError)" Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes" />

		<?ifdef CorporateAgentSource?>
		<Property Id="YESDESK_AGENT_EXISTING">
			<RegistrySearch Id="YesDeskCorporateAgentService" Root="HKLM" Bitness="always64"
				Key="SYSTEM\CurrentControlSet\Services\YESDeskAgent" Name="ImagePath" Type="raw" />
		</Property>
		<Launch Condition="Installed OR (NOT WIX_UPGRADE_DETECTED AND NOT YESDESK_AGENT_EXISTING AND NOT YESDESK_EXISTING_SERVICE)"
			Message="The unified pilot package requires a clean test computer. Existing YES Desk installations and services must be migrated separately." />
		<Feature Id="CorporateAgent" Level="1" AllowAdvertise="no" AllowAbsent="no" Title="YES Desk Management Agent">
			<ComponentRef Id="CorporateAgentService" />
		</Feature>
		<?else?>
		<?ifdef YesDesk?>
		<Property Id="YESDESK_UNIFIED_AGENT">
			<RegistrySearch Id="YesDeskUnifiedAgentOwner" Root="HKLM" Bitness="always64"
				Key="Software\YES Apart\YES Desk\Installer" Name="CorporateAgentIncluded" Type="raw" />
		</Property>
		<Launch Condition="Installed OR NOT YESDESK_UNIFIED_AGENT"
			Message="The installed YES Desk Agent is owned by a unified pilot package. Use the approved migration procedure." />
		<?endif?>
		<?endif?>

		<Feature Id="App" Level="1" AllowAdvertise="no" Display="expand" Title="!(loc.F_App)" Description="!(loc.F_App_Desc)" AllowAbsent="no">
			<ComponentGroupRef Id="Components" />

			<ComponentRef Id="Product.Registry.InstallFolder" />
			<ComponentRef Id="Product.Registry.DefaultIcon" />
			<ComponentRef Id="Product.Registry.CommandPlay" />
			<ComponentRef Id="Product.Registry.URLProtocol" />
			<ComponentRef Id="Product.Registry.Command" />
			<ComponentRef Id="Product.Registry.UninstallApp" />
			<ComponentRef Id="App.StartMenu" />
			<ComponentRef Id="Product.Registry.PersistedStartMenuShortcutProperties1" />
			<ComponentRef Id="Product.Registry.PersistedStartMenuShortcutProperties0" />
			<ComponentRef Id="Product.Registry.PersistedDesktopShortcutProperties1" />
			<ComponentRef Id="Product.Registry.PersistedDesktopShortcutProperties0" />
			<ComponentRef Id="Product.Registry.PersistedPrinterProperties1" />
			<ComponentRef Id="Product.Registry.PersistedPrinterProperties0" />
		</Feature>

		<!--https://wixtoolset.org/docs/tools/wixext/wixui/#customizing-a-dialog-set-->
		<!--$CustomBitmapsStart$-->
		<!--$CustomBitmapsEnd$-->
	</Package>
</Wix>
